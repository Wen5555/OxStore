# 复制为 .env 后填写；不要提交真实 .env。不要使用旧公开凭据。
DB_PASSWORD=
# 使用 openssl rand -hex 32 生成至少 32 字节随机 JWT 密钥
JWT_SECRET=
# 另用 openssl rand -hex 32 生成；有有效买家口令时保持稳定，不随 JWT 轮换。
TOKEN_LOOKUP_KEY=
# 仅首次创建 admin 账号需要；已有账号后可留空，修改密码不会被重置。
ADMIN_INITIAL_PASSWORD=
# 仅从旧库迁移后填写截止时间（例如 2026-10-01T10:00:00），标识此前历史可能不完整。
HISTORY_COMPLETE_SINCE=
